package oOOps;

class demoparent {
    public void name() {
        System.out.println("I'm a parent class");
    }
}

class Demo1 extends demoparent {
    @Override
    public void name() {
    	
        System.out.println("I'm a child class");
    }
}

public class MethodOverriding {
    public static void main(String[] args) {
        demoparent obj = new demoparent(); // parent reference, child object
        obj.name(); // calls child method
    }
}