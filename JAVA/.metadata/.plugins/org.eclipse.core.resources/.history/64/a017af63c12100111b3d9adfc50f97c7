package logicalpratice;

public class Armstrong_number {

	public static void main(String[] args) {

		int num=1000;
		int temp=num;
		int sum=0;
		
		
		while(num!=0) {
			
			int rem = num % 10;
			sum= sum+(rem*rem*rem);
			num/=10;
			
		}
		if(temp==sum) {
			System.out.println( temp + " armstrong");
		}
		else {
			System.out.println(temp +" not arm strong");
		}
		
		
		
	}

}
