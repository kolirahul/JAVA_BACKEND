package thread;

class t1 extends Thread
{
	public void run()
    {
		for(int i=0;i<=5;i++) {
			System.out.println(" T1: "+i);
		}
    }
}
public class ThreadDemo2 {

	public static void main(String[] args) {
		
		

		t1 t=new t1();
		t1 te=new t1();
		t1 ter=new t1();
		
		t.start();
		te.start();
		ter.start();
	}

}
