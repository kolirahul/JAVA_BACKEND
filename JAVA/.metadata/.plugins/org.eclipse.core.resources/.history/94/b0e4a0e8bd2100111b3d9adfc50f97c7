package logicalpratice;

public class palindrome_number {

	public static void main(String[] args) {

		int num=54545;
		int rev=0;
		int temp=num;
		
		while(num!=0) {
			
			int rem=num%10;
			    rev=rev*10+rem;
			    num=num/10;
			    
//			    System.out.println(rev +" reverse number :");
			    
			    if(temp==rev) {
			    	System.out.println("palindrome number :");
			    }
			    else
			    {
			    	System.out.println("not palindrome :");
			    }
			
		}
		
		
		

	}

}
